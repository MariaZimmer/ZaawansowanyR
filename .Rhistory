pobierz_szczegoly <- function(link) {
strona_oferty <- read_html(link)
tekst <- strona_oferty |>
html_text2()
numer <- stri_extract_first_regex(tekst, "Ogłoszenie nr\\s*\\d+")
numer <- stri_extract_first_regex(numer, "\\d+")
liczba_stanowisk <- stri_match_first_regex(
tekst,
"Liczba stanowisk\\s*(\\d+)"
)[,2]
wymiar_etatu <- stri_match_first_regex(
tekst,
"Wymiar etatu\\s*([0-9]+(?:[,.][0-9]+)?)"
)[,2]
wynagrodzenie <- stri_match_first_regex(
tekst,
"Wynagrodzenie zasadnicze\\s*(.+)"
)[,2]
data.frame(
numer = numer,
liczba_stanowisk = liczba_stanowisk,
wymiar_etatu = wymiar_etatu,
wynagrodzenie = wynagrodzenie,
stringsAsFactors = FALSE
)
}
