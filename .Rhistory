attr(bkl$y1, "labels")
attr(dane_bkl$y1, "labels")
table(dane_bkl$y1, useNA = "ifany")
table(as_factor(dane_bkl$y1), useNA = "ifany")
bkl$Y_praca_zagranica <- ifelse(bkl$y1 == 1, 1,
ifelse(bkl$y1 == 0, 0, NA))
dane_bkl$Y_praca_zagranica <- ifelse(dane_bkl$y1 == 1, 1,
ifelse(dane_bkl$y1 == 0, 0, NA))
table(dane_bkl$Y_praca_zagranica, useNA = "ifany")
prop.table(table(dane_bkl$Y_praca_zagranica)) * 100
table(bkl$rok, bkl$y1, useNA = "ifany")
