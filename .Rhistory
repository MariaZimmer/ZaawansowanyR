## wartości globalne BAEL Q4 2021 (w tys.)
pop_totals_status <- c(`(Intercept)`           = 16780 + 497 + 12529,  # = 29806
`statusBezrobotny`      = 497,
`statusBierny zawodowo` = 12529)
ipw_status <- nonprob(selection = ~ status,
target = ~ n1,
pop_totals = pop_totals_status,
data = bkl,
method_selection = "logit",
control_selection = control_sel(est_method = "gee"))
ipw_status
## Tutaj kod (R) -- zbudować pop_totals_wiek (z dummies dla wiek + status + plec),
##                  uruchomić nonprob() z selection = ~ wiek + status + plec,
##                  wynik zapisać do `ipw_wiek`.
colnames(model.matrix(~ wiek + status + plec, data = bkl))
pop_totals_wiek <- c(`(Intercept)` = 29806,
`wiek25-34` = 4612,
`wiek35-44` = 5672,
`wiek45-59/64` = 8025,
`wiek60/65-89` = 8115,
`statusBezrobotny`      = 497,
`statusBierny zawodowo` = 12529,
`pleckobiety` = 15530)
ipw_wiek <- nonprob(selection = ~ wiek + status + plec,
target = ~ n1,
pop_totals = pop_totals_wiek,
data = bkl,
method_selection = "logit",
control_selection = control_sel(est_method = "gee"))
ipw_wiek
## walidacja kalibracji do statusu (sekcja a.i)
check_balance(~status-1,ipw_status)
check_balance(~wiek-1,ipw_wiek)
## bez wag (naiwne)
mean(bkl$n1)
## skalibrowane oszacowania -- mean + SE + CI bezpośrednio z extract()
rbind(
"do BAEL"               = extract(ipw_status),
"do wiek + BAEL + płeć" = extract(ipw_wiek)
)
#install.packages("haven")
#install.packages("tidyverse")
#install.packages("nonprobsvy")
library(readxl)
library(haven)
library(nonprobsvy)
library(dplyr)
dane_bkl <- read_sav("Poczona_baza_danych_z_badania_ludnoci_z_lat_20172019_i_2021.sav")
#zmienna y1 odsetek osób pracujących za granicą
attr(dane_bkl$y1, "labels")
table(dane_bkl$y1, useNA = "ifany")
table(as_factor(dane_bkl$y1), useNA = "ifany")
dane_bkl$Y <- ifelse(dane_bkl$y1 == 1, 1,
ifelse(dane_bkl$y1 == 0, 0, NA))
table(dane_bkl$Y, useNA = "ifany")
prop.table(table(dane_bkl$Y)) * 100
#Tylko ok 3,58% respondentów ma pracowało zarobkowo zagranicą w ciągu ostatnich 12 miesięcy
table(dane_bkl$rok, dane_bkl$y1, useNA = "ifany")
prop.table(table(dane_bkl$rok, dane_bkl$y1), margin = 1) * 100
# Wartość zmiennej w poszczególnych latach
# Poprawiona zmienna woj_operat
woj_levels <- c(
"dolnośląskie", "kujawsko-pomorskie", "lubelskie", "lubuskie",
"łódzkie", "małopolskie", "mazowieckie", "opolskie",
"podkarpackie", "podlaskie", "pomorskie", "śląskie",
"świętokrzyskie", "warmińsko-mazurskie", "wielkopolskie",
"zachodniopomorskie"
)
dane_bkl$woj_raw <- as.numeric(dane_bkl$woj_operat)
dane_bkl$woj_idx <- ifelse(
dane_bkl$rok == 2017,
dane_bkl$woj_raw,
dane_bkl$woj_raw / 2
)
dane_bkl$woj_clean <- factor(
woj_levels[dane_bkl$woj_idx],
levels = woj_levels
)
table(dane_bkl$rok, dane_bkl$woj_clean, useNA = "ifany")
vars <- c("wiek_4k", "miejsce", "woj_clean", "g2_3", "k24", "w9_1")
wyniki <- data.frame()
for (v in vars) {
x <- dane_bkl[[v]]
if (inherits(x, "haven_labelled")) {
x <- as_factor(zap_missing(x))
} else {
x <- factor(x)
}
tmp <- data.frame(
x = x,
Y = dane_bkl$Y
)
tmp <- na.omit(tmp)
tmp$x <- droplevels(tmp$x)
tmp$Y <- droplevels(factor(tmp$Y))
tab <- table(tmp$x, tmp$Y)
test <- suppressWarnings(chisq.test(tab, correct = FALSE))
chi2 <- as.numeric(test$statistic)
n <- sum(tab)
V <- sqrt(chi2 / (n * (min(dim(tab)) - 1)))
wyniki <- rbind(wyniki, data.frame(
zmienna = v,
V_Cramera = round(V, 3),
p_value = signif(test$p.value, 4),
kategorie = nrow(tab),
n = n
))
}
wyniki
