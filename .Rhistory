x <- as_factor(dane_bkl[[v]])
y <- dane_bkl$Y_praca_zagranica
dane <- data.frame(x = x, y = y)
dane <- dane[complete.cases(dane), ]
if (length(unique(dane$x)) < 2) return(NULL)
if (length(unique(dane$y)) < 2) return(NULL)
tab <- table(dane$x, dane$y)
test <- suppressWarnings(chisq.test(tab, correct = FALSE))
chi2 <- as.numeric(test$statistic)
n <- sum(tab)
r <- nrow(tab)
c <- ncol(tab)
v_cramer <- sqrt(chi2 / (n * min(r - 1, c - 1)))
min_expected <- min(test$expected)
pct_low_expected <- mean(test$expected < 5) * 100
data.frame(
zmienna = v,
etykieta = attr(dane_bkl[[v]], "label"),
n = n,
liczba_kategorii = r,
chi2 = round(chi2, 3),
df = as.numeric(test$parameter),
p_value = signif(test$p.value, 4),
V_Cramera = round(v_cramer, 3),
min_liczebnosc_oczekiwana = round(min_expected, 3),
procent_komorek_ponizej_5 = round(pct_low_expected, 1)
)
}
wyniki_x <- bind_rows(lapply(vars_x, cramer_test)) %>%
arrange(desc(V_Cramera))
wyniki <- data.frame()
for (v in vars) {
x <- dane_bkl[[v]]
if (inherits(x, "haven_labelled")) x <- as_factor(x)
y <- dane_bkl$Y
ok <- complete.cases(x, y)
tab <- table(x[ok], y[ok])
test <- suppressWarnings(chisq.test(tab, correct = FALSE))
chi2 <- as.numeric(test$statistic)
n <- sum(tab)
V <- sqrt(chi2 / (n * (min(dim(tab)) - 1)))
wyniki <- rbind(
wyniki,
data.frame(
zmienna = v,
kategorie = nrow(tab),
n = n,
chi2 = round(chi2, 3),
p_value = signif(test$p.value, 4),
V_Cramera = round(V, 3),
min_oczekiwana = round(min(test$expected), 3),
proc_komorek_ponizej_5 = round(mean(test$expected < 5) * 100, 1)
)
)
}
