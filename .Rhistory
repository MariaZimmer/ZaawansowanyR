filter(!is.na(wyksztalcenie)) |>
filter(!is.na(n1)) |>
## zostawiamy tylko kolumny zmapowane do BAEL + zmienną wynikową n1
select(plec, wiek, wyksztalcenie, status, n1)
head(bkl)
table(bkl$plec)
table(bkl$wiek)
table(bkl$wyksztalcenie)
table(bkl$status)
table(bkl$n1)
## Tutaj kod (R)
## Wskazówka: table(), prop.table(), addmargins()
tab1 <- table(bkl$n1, bkl$plec)
tab2 <- table(bkl$n1, bkl$wiek)
tab3 <- table(bkl$n1, bkl$wyksztalcenie)
tab4 <- table(bkl$n1, bkl$status)
tab1
tab2
tab3
tab4
prop.table(tab1, margin = 2)
prop.table(tab2, margin = 2)
prop.table(tab3, margin = 2)
prop.table(tab4, margin = 2)
## Tutaj kod (R)
## Wskazówka: chisq.test(); pakiet vcd
chisq.test(tab1)
assocstats(tab1)
chisq.test(tab2)
assocstats(tab2)
chisq.test(tab3)
assocstats(tab3)
chisq.test(tab4)
assocstats(tab4)
## Tutaj kod (R)
## Wskazówka: prop.table(table(...)) albo podobne
ods_status <- prop.table(table(bkl$status))
ods_plec <- prop.table(table(bkl$plec))
ods_wiek <- prop.table(table(bkl$wiek))
ods_wyk <- prop.table(table(bkl$wyksztalcenie))
ods_status
ods_wiek
ods_wiek
ods_wyk
