dane_bkl <- read_sav("../dane-surowe/proj_bi/Poczona_baza_danych_z_badania_ludnoci_z_lat_20172019_i_2021.sav")
#zmienna y1 odsetek osób pracujących za granicą
#dane_bkl <- dane_bkl %>% mutate(y1 = as.integer(y1)) %>% mutate(m2 = as.integer(m2))
# m2 to płec 1-kobieta 0-mężczyzna
#cor(dane_bkl$y1, dane_bkl$m2, use = "complete.obs")
attr(bkl$y1, "labels")
attr(dane_bkl$y1, "labels")
table(dane_bkl$y1, useNA = "ifany")
table(as_factor(dane_bkl$y1), useNA = "ifany")
bkl$Y_praca_zagranica <- ifelse(bkl$y1 == 1, 1,
ifelse(bkl$y1 == 0, 0, NA))
dane_bkl$Y_praca_zagranica <- ifelse(dane_bkl$y1 == 1, 1,
ifelse(dane_bkl$y1 == 0, 0, NA))
table(dane_bkl$Y_praca_zagranica, useNA = "ifany")
prop.table(table(dane_bkl$Y_praca_zagranica)) * 100
table(bkl$rok, bkl$y1, useNA = "ifany")
table(dane_bkl$rok, dane_bkl$y1, useNA = "ifany")
prop.table(table(dane_bkl$rok, dane_bkl$y1), margin = 1) * 100
vars_x <- c("woj", "miejsce", "wiek_4K", "g2_3", "k24", "w9_1")
# Sprawdzenie, czy zmienne istnieją w bazie
vars_x %in% names(dane_bkl)
vars_x <- c("woj", "miejsce", "wiek_4k", "g2_3", "k24", "w9_1")
# Sprawdzenie, czy zmienne istnieją w bazie
vars_x %in% names(dane_bkl)
vars_x <- c("woj", "miejsce", "wiek_4k", "g2_3", "k24", "w9_1")
# Etykiety zmiennych
sapply(dane_bkl[vars_x], function(x) attr(x, "label"))
# Kody odpowiedzi
lapply(dane_bkl[vars_x], function(x) attr(x, "labels"))
cramer_test <- function(v) {
x <- as_factor(dane_bkl[[v]])
y <- dane_bkl$Y_praca_zagranica
dane <- data.frame(x = x, y = y)
dane <- dane[complete.cases(dane), ]
if (length(unique(dane$x)) < 2) return(NULL)
if (length(unique(dane$y)) < 2) return(NULL)
tab <- table(dane$x, dane$y)
test <- suppressWarnings(chisq.test(tab, correct = FALSE))
chi2 <- as.numeric(test$statistic)
n <- sum(tab)
r <- nrow(tab)
c <- ncol(tab)
v_cramer <- sqrt(chi2 / (n * min(r - 1, c - 1)))
min_expected <- min(test$expected)
pct_low_expected <- mean(test$expected < 5) * 100
data.frame(
zmienna = v,
etykieta = attr(dane_bkl[[v]], "label"),
n = n,
liczba_kategorii = r,
chi2 = round(chi2, 3),
df = as.numeric(test$parameter),
p_value = signif(test$p.value, 4),
V_Cramera = round(v_cramer, 3),
min_liczebnosc_oczekiwana = round(min_expected, 3),
procent_komorek_ponizej_5 = round(pct_low_expected, 1)
)
}
wyniki_x <- bind_rows(lapply(vars_x, cramer_test)) %>%
arrange(desc(V_Cramera))
wyniki_x
